# Nur für die lokale Entwicklung (als .env.local kopieren).
# In der Pipeline kommt der Wert aus der GitHub-Variable SITE_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kontaktformular (optional). Ohne SMTP_HOST öffnet das Formular das
# E-Mail-Programm. Zum Testen reicht Mailpit (README → „Kontaktformular“):
#   SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_FROM=test@localhost
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# CONTACT_TO=
